{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.mohfalahisnan.anubis",
  "productName": "Anubis",
  "asar": true,
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "apps/desktop/dist-electron",
    "packages/frontend/dist",
    "packages/backend/dist",
    "packages/backend/package.json",
    "packages/backend/node_modules/**",
    "packages/ai-agent/dist",
    "packages/ai-agent/package.json",
    "packages/conversation/dist",
    "packages/conversation/package.json",
    "packages/research-crawler/dist",
    "packages/research-crawler/package.json"
  ],
  "asarUnpack": [
    "packages/backend/dist/**",
    "packages/backend/node_modules/**",
    "packages/ai-agent/dist/**",
    "packages/ai-agent/package.json",
    "packages/conversation/dist/**",
    "packages/conversation/package.json",
    "packages/research-crawler/dist/**",
    "packages/research-crawler/package.json"
  ],
  "mac": {
    "identity": null,
    "artifactName": "${productName}_${version}.${ext}",
    "target": [
      "dmg",
      "zip"
    ]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}_${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "publish": {
    "provider": "github",
    "owner": "mohfalahisnan",
    "repo": "anubis-workspaces"
  }
}
