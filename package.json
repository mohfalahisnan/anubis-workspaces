{
  "name": "anubis-workspaces",
  "version": "0.1.0",
  "private": true,
  "description": "Anubis desktop app.",
  "license": "MIT",
  "type": "module",
  "main": "apps/desktop/dist-electron/main/index.js",
  "author": {
    "name": "Mohamad Falah Isnan",
    "email": "m.falah.isnan@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohfalahisnan/anubis-workspaces.git"
  },
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @anubis/research-crawler build && pnpm --filter @anubis/ai-agent build && pnpm --filter @anubis/backend build && pnpm --filter @anubis/frontend build && vite build && electron-builder --config electron-builder.json",
    "preview": "pnpm --filter @anubis/frontend preview",
    "pretest": "pnpm --filter @anubis/research-crawler build && pnpm --filter @anubis/ai-agent build && pnpm --filter @anubis/backend build && pnpm --filter @anubis/frontend build && vite build --mode=test",
    "test": "vitest run",
    "test:e2e": "pnpm pretest && playwright test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-electron": "^1.0.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3"
    }
  }
}
