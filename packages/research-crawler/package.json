{
  "name": "research-crawler",
  "version": "0.2.2",
  "description": "Headless browser scraping and crawling core for the Anubis backend.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "benchmark:capture": "pnpm build && node scripts/benchmark-capture.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "esbuild": "^0.28.0",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  }
}
